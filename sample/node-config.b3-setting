    "output": [
      "当前时间"
    ],
    "status": [
      "success"
    ]
  },
  {
    "name": "Once",
    "type": "Decorator",
    "desc": "只执行一次",
    "doc": "+ 只能有一个子节点，多个仅执行第一个\n+ 被打断后该节点后的子节点依旧不会执行\n+ 该节点执行后永远返回「成功」",
    "status": [
      "success",
      "failure",
      "|running"
    ]
  },
  {
    "name": "Parallel",
    "type": "Composite",
    "desc": "并行执行",
    "doc": "执行所有子节点并返回「成功」/「运行中」",
    "status": [
      "success",
      "|running"
    ]
  },
  {
    "name": "Push",
    "type": "Action",
    "children": 0,
    "status": [
      "success",
      "failure"
    ],
    "desc": "向数组中添加元素",
    "input": [
      "数组",
      "元素"
    ],
    "doc": "+ 当变量`数组`不是数组类型时返回 `failure`\n+ 其余返回 `success`\n"
  },
  {
    "name": "Race",
    "type": "Composite",
    "status": [
      "|success",
      "&failure",
      "|running"
    ],
    "children": -1,
    "desc": "竞争执行",
    "doc": "+ 并行执行所有子节点\n+ 当有子节点返回 `success` 时，立即返回 `success` 状态，并中断其他子节点\n+ 如果所有子节点返回 `failure` 则返回 `failure`"
  },
  {
    "name": "RandomIndex",
    "type": "Action",
    "children": 0,
    "status": [
      "success",
      "failure"
    ],
    "desc": "随机返回输入的其中一个!",
    "input": [
      "输入目标"
    ],
    "output": [
      "随机目标",
      "索引?"
    ],
    "doc": "+ 合法元素不包括 `undefined` 和 `null`\n+ 在输入数组中，随机返回其中一个\n+ 当输入数组为空时，或者没有合法元素，返回 `failure`\n"
  },
  {
    "name": "Repeat",
    "type": "Decorator",
    "children": 1,
    "status": [
      "success",
      "|running",
      "|failure"
    ],
    "desc": "循环执行",
    "input": [
      "循环次数?"
    ],
    "args": [
      {
        "name": "count",
        "type": "int?",
        "desc": "循环次数",
        "oneof": "循环次数"
      }
    ],
    "doc": "+ 只能有一个子节点，多个仅执行第一个\n+ 当子节点返回 `failure` 时，退出遍历并返回 `failure` 状态\n+ 执行完所有子节点后，返回 `success`\n"
  },
  {
    "name": "RetryUntilFailure",
    "type": "Decorator",
    "children": 1,
    "status": [
      "!success",
      "failure",
      "running"
    ],
    "desc": "一直尝试直到子节点返回失败",
    "input": [
      "最大尝试次数?"
    ],
    "args": [
      {
        "name": "count",
        "type": "int?",
        "desc": "最大尝试次数"
      }
    ],
    "doc": "+ 只能有一个子节点，多个仅执行第一个\n+ 只有当子节点返回 `failure` 时，才返回 `success`，其它情况返回 `running` 状态\n+ 如果设定了尝试次数，超过指定次数则返回 `failure`"
  },
  {
    "name": "RetryUntilSuccess",
    "type": "Decorator",
    "children": 1,
    "status": [
      "|success",
      "failure",
      "running"
    ],
    "desc": "一直尝试直到子节点返回成功",
    "input": [
      "最大尝试次数?"
    ],
    "args": [
      {
        "name": "count",
        "type": "int?",
        "desc": "最大尝试次数"
      }
    ],
    "doc": "+ 只能有一个子节点，多个仅执行第一个\n+ 只有当子节点返回 `success` 时，才返回 `success`，其它情况返回 `running` 状态\n+ 如果设定了尝试次数，超过指定次数则返回 `failure`"
  },
  {
    "name": "Selector",
    "type": "Composite",
    "desc": "选择执行",
    "doc": "+ 一直往下执行，有子节点返回「成功」则返回「成功」\n+ 若全部节点返回「失败」则返回「失败」\n+ 子节点是或 (OR) 的关系",
    "status": [
      "|success",
      "&failure",
      "|running"
    ],
    "preemptive": true
  },
  {
    "name": "Sequence",
    "type": "Composite",
    "desc": "顺序执行",
    "doc": "+ 一直往下执行，只有当所有子节点都返回「成功」, 才返回「成功」\n+ 子节点是与（AND）的关系",
    "status": [
      "&success",
      "|failure",
      "|running"
    ]
  },
  {
    "name": "SetField",
    "type": "Action",
    "children": 0,
    "status": [
      "success",
      "failure"
    ],
    "desc": "设置对象字段值",
    "input": [
      "输入对象",
      "字段(field)?",
      "值(value)?"
    ],
    "args": [
      {
        "name": "field",
        "type": "string?",
        "desc": "字段(field)",
        "oneof": "字段(field)"
      },
      {
        "name": "value",
        "type": "json?",
        "desc": "值(value)",
        "oneof": "值(value)"
      }
    ],
    "doc": "+ 对输入对象设置 `field` 和 `value`\n+ 输入参数1必须为对象，否则返回 `failure`\n+ 如果 `field` 不为 `string`, 也返回 `failure`\n+ 如果 `value` 为 `undefined` 或 `null`, 则删除 `field` 的值\n"
  },
  {
    "name": "Switch",
    "type": "Composite",
    "children": -1,
    "status": [
      "|success",
      "|failure",
      "|running"
    ],
    "desc": "分支执行",
    "doc": "+ 按顺序测试 `Case` 节点的判断条件（第一个子节点）\n+ 若测试返回 `success` 则执行 `Case` 第二个子节点，并返回子节点的执行状态\n+ 若没有判断为 `success` 的 `Case` 节点，则返回 `failure`\n"
  },
  {
    "name": "Timeout",
    "type": "Decorator",
    "desc": "超时",
    "args": [
      {
        "name": "time",
        "type": "float",
        "default": 2.5,
        "desc": "超时时间"
      }
    ],
    "doc": "+ 只能有一个子节点，多个仅执行第一个\n+ 当子节点执行超时或返回「失败」时，返回「失败」\n+ 其余情况返回子节点的执行状态\n",
    "status": [
      "|success",
      "|running",
      "failure"
    ]
  },
  {
    "name": "Wait",
    "type": "Action",
    "desc": "等待",
    "input": [
      "等待时间?"
    ],
    "args": [
      {
        "name": "time",
        "type": "float",
        "desc": "等待时间",
        "checker": "positive"
      },
      {
